PORT=3000

# Anthropic API key — powers the local FlexiAgent knowledge-base chatbot
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# FlexiAgent webhook — paste your actual endpoint here
FLEXI_AGENT_WEBHOOK_URL=https://your-flexiagent-url/webhook

# API key sent as: Authorization: Bearer <key>
FLEXI_AGENT_API_KEY=your_api_key_here

# Optional: label shown in the chat header
BOT_NAME=FlexiAgent
